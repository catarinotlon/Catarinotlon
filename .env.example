# Database. Local development uses a file.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated allowlist. An admin must also have a verified email.
ADMIN_EMAILS=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Use EMAIL_TRANSPORT=memory locally to avoid sending real email, or
# EMAIL_TRANSPORT=mailpit to read every email in a local inbox
# (`docker compose up -d mailpit`, then open http://localhost:8025).
EMAIL_TRANSPORT=memory
RESEND_API_KEY=
EMAIL_FROM=
MAILPIT_URL=http://localhost:8025

# Bearer secret for the scheduled race reminders. Without it the endpoint stays closed.
CRON_SECRET=

# Sentry (optional until production is decided)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog product analytics and session replay (public project key, phc_…). Leave empty to turn it off.
NEXT_PUBLIC_POSTHOG_KEY=

# Cloudflare Turnstile, the "are you a person?" check on the sign-up form. Set both or
# neither: without them the form has no check (local development and E2E). Cloudflare's
# test keys (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA)
# always pass, for trying the widget locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob. Connected projects authenticate with OIDC and a store id.
# RECEIPT_STORAGE=memory keeps receipts on the local disk for development and E2E.
RECEIPT_STORAGE=memory
BLOB_READ_WRITE_TOKEN=
# Maximum receipt size in bytes (default 5 MB).
RECEIPT_MAX_BYTES=5242880
